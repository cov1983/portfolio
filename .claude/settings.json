{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make setup)",
      "Bash(make verify)",
      "Bash(make format*)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test *)",
      "Bash(make test-e2e)",
      "Bash(make build)",
      "Bash(make perf)",
      "Bash(pnpm exec *)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr *)",
      "Read(/**)",
      "Edit(/docs/**)",
      "Edit(/src/**)",
      "Edit(/tests/**)",
      "Edit(/scripts/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(terraform apply *)",
      "Bash(tofu apply *)",
      "Bash(az * delete)",
      "Bash(az * delete *)",
      "Bash(kubectl delete *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/secrets/**)",
      "Edit(/infra/prod/**)"
    ],
    "ask": [
      "Edit(/docs/spec/**)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
