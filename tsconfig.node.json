{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vercel-headers.ts",
    "vercel-headers.test.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "build/**/*.ts"
  ]
}
